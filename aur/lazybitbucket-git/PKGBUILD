# Maintainer: lsst25 <https://github.com/lsst25>
pkgname=lazybitbucket-git
pkgver=0.0.0
pkgrel=1
pkgdesc="Terminal UI for Bitbucket Cloud pull requests (builds from git source)"
arch=('x86_64' 'aarch64')
url="https://github.com/lsst25/lazybitbucket"
license=('MIT')
provides=('lazybitbucket')
conflicts=('lazybitbucket' 'lazybitbucket-bin')
makedepends=('go' 'git')
source=("${pkgname}::git+https://github.com/lsst25/lazybitbucket.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  ( set -o pipefail
    git describe --long --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || \
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

build() {
  cd "${srcdir}/${pkgname}"
  export CGO_ENABLED=0
  go build -ldflags "-s -w -X main.version=${pkgver}" -o lazybitbucket ./cmd/lazybitbucket
}

package() {
  cd "${srcdir}/${pkgname}"
  install -Dm755 lazybitbucket "${pkgdir}/usr/bin/lazybitbucket"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
